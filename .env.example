# Copy to .env and adjust. Every setting has a default, so .env is optional.

# Postgres (docker-compose.yml creates this user and database)
DATABASE_URL=postgresql+psycopg://bane:bane@localhost:5432/bane
# Used by the backend tests; the tests drop and recreate its schema
TEST_DATABASE_URL=postgresql+psycopg://bane:bane@localhost:5432/bane_test

# Where uploaded and generated files are kept (default: ./data in the repo)
# DATA_DIR=/absolute/path/to/data

# Local LLM (Ollama)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
# Context window in tokens (sent with every request). Lower it if the model doesn't fit in your
# GPU's memory (`ollama ps` should show 100% GPU); raise it for very long prompts.
LLM_NUM_CTX=8192

# Largest accepted upload, in megabytes
MAX_UPLOAD_MB=10

# Web Job Scraper
# google_playwright: drives Google's jobs search in a browser (run `make scraper-browser` once;
#   against Google's terms of service and may be blocked). serpapi: needs SERPAPI_KEY.
#   fake: canned postings, for trying the app.
JOB_SOURCE=google_playwright
# SERPAPI_KEY=
# Seconds to wait between page actions when scraping Google
SCRAPER_DELAY_S=2
# Use an existing Chromium instead of the one `make scraper-browser` downloads
# SCRAPER_CHROMIUM_PATH=
# Answer LLM prompts with canned replies instead of calling Ollama (demos and E2E tests)
# LLM_FAKE=true
